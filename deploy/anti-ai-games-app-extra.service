[Unit]
Description=Anti AI Games second web worker
After=network-online.target anti-ai-games-app.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/anti-ai-games
EnvironmentFile=/root/anti-ai-games/.env
Environment=NODE_ENV=production
Environment=JEV_MAX_CONCURRENT=8
ExecStart=/usr/bin/npm run start -- -p 3006
Restart=always
RestartSec=3
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
