[Unit]
Description=Anti AI Games Mini App
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/root/anti-ai-games
EnvironmentFile=/root/anti-ai-games/.env
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/docker compose up -d postgres
ExecStart=/usr/bin/npm run start -- -p 3001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
