[Unit]
Description=Anti AI Games Phrase Hunt Telegram announcement worker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/root/anti-ai-games
EnvironmentFile=/root/anti-ai-games/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run phrase-hunt-announcement-worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
