generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameType {
  IRAN_CITY
  COUNTRY
  ADJECTIVE
  ADJECTIVE_RAIN
  SEMANTRIS
  LETTER_DUEL
  PHRASE_HUNT
}

enum GameStatus {
  ACTIVE
  WON
  LOST
  DRAW
  SURRENDERED
}

enum LetterDuelMode {
  PRIVATE
  RANDOM
}

enum LetterDuelStatus {
  WAITING
  ACTIVE
  ENDED
}

enum LetterDuelRoundStatus {
  PICKING
  ANSWERING
  JUDGING
  RESOLVED
  CANCELLED
}

enum LetterDuelSubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  ERROR
}

model User {
  feedback Feedback[]
  competitiveRatings CompetitiveRating[]
  letterPractice LetterDuelPracticeRound?
  id                               String                 @id
  firstName                        String?
  lastName                         String?
  username                         String?
  photoUrl                         String?
  phraseHuntOnboardedAt            DateTime?
  wordWeaverOnboardedAt            DateTime?
  countryRacesAsOne               CountryRace[] @relation("RaceOne")
  countryRacesAsTwo               CountryRace[] @relation("RaceTwo")
  countryRaceGuesses              CountryRaceGuess[]
  countryChallengeEntries         CountryChallengeEntry[]
  countryChallengeGuesses         CountryChallengeGuess[]
  countryMatchSearches            CountryMatchSearch[]
  countryMatchOffersSent          CountryMatchOffer[] @relation("CountryMatchSender")
  countryMatchOffersReceived      CountryMatchOffer[] @relation("CountryMatchRecipient")
  countryMatchState               CountryMatchState?
  appPresence                     AppPresence[]
  games                            GameSession[]
  presence                         OnlinePresence?
  acceptsGameInvites               Boolean @default(true)
  showUsername                     Boolean @default(true)
  sentDuelInvites                  DuelInvite[] @relation("InviteSender")
  receivedDuelInvites              DuelInvite[] @relation("InviteRecipient")
  letterDuelConnectionsAsPlayerOne LetterDuelConnection[] @relation("LetterDuelPlayerOne")
  letterDuelConnectionsAsPlayerTwo LetterDuelConnection[] @relation("LetterDuelPlayerTwo")
  letterDuelSubmissions            LetterDuelSubmission[]
  wordWeaverPresence               WordWeaverPresence[]
  wordWeaverEntries                WordWeaverEntry[]
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
}

enum FeedbackKind {
  SUGGESTION
  CRITICISM
  BUG
  FEATURE
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  ACCEPTED
  IMPLEMENTED
}

model Feedback {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  fingerprint String
  kind FeedbackKind
  title String
  body String
  status FeedbackStatus @default(PENDING)
  reply String?
  approvedAt DateTime?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, requestId])
  @@unique([userId, fingerprint])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OnlinePresence {
  userId     String   @id
  isPlaying  Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPlaying, lastSeenAt])
  @@index([lastSeenAt])
}

model AppPresence {
  userId     String
  clientId   String
  context    String   @default("MENU")
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, clientId])
  @@index([lastSeenAt, context])
}

model CountryChallenge {
  announcement PhraseHuntAnnouncement?
  gameType  GameType @default(COUNTRY)
  id        String @id
  startsAt  DateTime
  endsAt    DateTime
  targetId  String
  createdAt DateTime @default(now())
  entries   CountryChallengeEntry[]
  @@unique([gameType, startsAt])
  @@index([startsAt])
}

model CountryChallengeEntry {
  id          String @id @default(cuid())
  challengeId String
  userId      String
  status      String @default("ACTIVE")
  guessCount  Int @default(0)
  bestRank    Int?
  bestRankAt  DateTime?
  solvedAt    DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  challenge   CountryChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesses     CountryChallengeGuess[]
  @@unique([challengeId, userId])
  @@index([challengeId, status, guessCount, solvedAt])
  @@index([userId, createdAt])
}

model CountryChallengeGuess {
  id        String @id @default(cuid())
  entryId   String
  userId    String
  itemId    String
  rank      Int
  createdAt DateTime @default(now())
  entry     CountryChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([entryId, itemId])
  @@index([entryId, rank, createdAt])
}

model CountryMatchSearch {
  gameType    GameType @default(COUNTRY)
  id          String @id @default(cuid())
  userId      String
  status      String @default("ACTIVE")
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  matchedRaceId String? @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers      CountryMatchOffer[]
  matchedRace CountryRace? @relation(fields: [matchedRaceId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([gameType, status, createdAt])
  @@index([userId, status])
}

model CountryMatchOffer {
  id          String @id @default(cuid())
  searchId    String
  senderId    String
  recipientId String
  status      String @default("PENDING")
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  raceId      String? @unique
  search      CountryMatchSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  sender      User @relation("CountryMatchSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User @relation("CountryMatchRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  race        CountryRace? @relation(fields: [raceId], references: [id], onDelete: SetNull)
  @@unique([searchId, recipientId])
  @@index([status, expiresAt])
  @@index([recipientId, status, createdAt])
}

model CountryMatchState {
  userId        String @id
  cooldownUntil DateTime?
  lastOfferedAt DateTime?
  updatedAt     DateTime @updatedAt
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([cooldownUntil])
  @@index([lastOfferedAt])
}

model GameSession {
  id                String               @id @default(cuid())
  userId            String
  type              GameType
  targetId          String
  datasetVersion    String
  status            GameStatus           @default(ACTIVE)
  guessesCount      Int                  @default(0)
  startedAt         DateTime             @default(now())
  finishedAt        DateTime?
  semantrisState    Json?
  letterDuelRoundId String?
  duelOwnScore      Int?
  duelOpponentScore Int?
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesses           Guess[]
  phraseGuesses     PhraseHuntGuess[]
  phraseChallengeId String?
  phraseChallenge   PhraseHuntChallenge? @relation(fields: [phraseChallengeId], references: [id], onDelete: Restrict)
  letterDuelRound   LetterDuelRound?     @relation(fields: [letterDuelRoundId], references: [id], onDelete: Cascade)

  @@unique([userId, phraseChallengeId])
  @@index([userId, type, status])
  @@index([type, status, finishedAt])
  @@index([userId, targetId])
  @@index([phraseChallengeId])
}

model PhraseHuntChallenge {
  id           String                  @id
  startsAt     DateTime                @unique
  endsAt       DateTime
  targetId     String
  judgeVersion Int
  judgeModel   String                  @default("typesafe/jev-1.13")
  games        GameSession[]
  announcement PhraseHuntAnnouncement?
}

enum PhraseHuntAnnouncementStatus {
  PENDING
  COMPLETED
}

enum PhraseHuntAnnouncementDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model PhraseHuntNotificationConfig {
  id             String    @id @default("global")
  enabledAt      DateTime  @default(now())
  sendNotBefore  DateTime?
}

model PhraseHuntAnnouncement {
  id          String                           @id @default(cuid())
  challengeId String?                          @unique
  geoChallengeId String?                       @unique
  geoChallenge CountryChallenge? @relation(fields: [geoChallengeId], references: [id], onDelete: Restrict)
  messageText String
  winnerUserIds String[] @default([])
  status      PhraseHuntAnnouncementStatus     @default(PENDING)
  createdAt   DateTime                         @default(now())
  completedAt DateTime?
  challenge   PhraseHuntChallenge?             @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  deliveries  PhraseHuntAnnouncementDelivery[]
}

model PhraseHuntAnnouncementDelivery {
  id             String                               @id @default(cuid())
  announcementId String
  chatId         String
  status         PhraseHuntAnnouncementDeliveryStatus @default(PENDING)
  attempts       Int                                  @default(0)
  nextAttemptAt  DateTime                             @default(now())
  leaseUntil     DateTime?
  sentAt         DateTime?
  lastError      String?
  announcement   PhraseHuntAnnouncement               @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, chatId])
  @@index([status, nextAttemptAt, leaseUntil])
}

model PhraseHuntGuess {
  id         String      @id @default(cuid())
  gameId     String
  phrase     String
  normalized String
  score      Float
  createdAt  DateTime    @default(now())
  game       GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, normalized])
  @@index([gameId, createdAt])
}

model PhraseHuntJudgmentLease {
  key       String   @id
  owner     String
  expiresAt DateTime
}

model PhraseHuntJudgment {
  id           String   @id @default(cuid())
  targetId     String
  phrase       String
  judgeVersion Int
  model        String   @default("typesafe/jev-1.13")
  score        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([targetId, phrase, judgeVersion, model])
}

model Guess {
  id        String      @id @default(cuid())
  gameId    String
  itemId    String
  rank      Int
  createdAt DateTime    @default(now())
  game      GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, itemId])
  @@index([gameId, createdAt])
}

model AdjectiveJudgment {
  id        String   @id @default(cuid())
  promptId  String
  word      String
  accepted  Boolean
  quality   Int
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promptId, word])
}

model LetterDuelConnection {
  id                 String            @id @default(cuid())
  mode               LetterDuelMode
  status             LetterDuelStatus  @default(WAITING)
  inviteToken        String?           @unique
  playerOneId        String
  playerTwoId        String?
  playerOneHeartbeat DateTime          @default(now())
  playerTwoHeartbeat DateTime?
  stateVersion       Int               @default(1)
  createdAt          DateTime          @default(now())
  startedAt          DateTime?
  endedAt            DateTime?
  matchWinnerUserId  String?
  endReason          String?
  rematchOneAt       DateTime?
  rematchTwoAt       DateTime?
  rematchConnectionId String?           @unique
  playerOne          User              @relation("LetterDuelPlayerOne", fields: [playerOneId], references: [id], onDelete: Cascade)
  playerTwo          User?             @relation("LetterDuelPlayerTwo", fields: [playerTwoId], references: [id], onDelete: Cascade)
  rounds             LetterDuelRound[]
  directInvite       DuelInvite?

  @@index([status, mode, createdAt])
  @@index([playerOneId, status])
  @@index([playerTwoId, status])
}

model LetterDuelRound {
  id              String                 @id @default(cuid())
  connectionId    String
  number          Int
  status          LetterDuelRoundStatus  @default(PICKING)
  playerOneLetter String?
  playerTwoLetter String?
  pickDeadline    DateTime
  answerDeadline  DateTime?
  winnerUserId    String?
  winningWord     String?
  resultReason    String?
  createdAt       DateTime               @default(now())
  resolvedAt      DateTime?
  connection      LetterDuelConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sessions        GameSession[]
  submissions     LetterDuelSubmission[]

  @@unique([connectionId, number])
  @@index([connectionId, status])
}

model LetterDuelSubmission {
  id         String                     @id @default(cuid())
  roundId    String
  userId     String
  word       String
  status     LetterDuelSubmissionStatus @default(PENDING)
  reason     String?
  receivedAt DateTime                   @default(now())
  judgedAt   DateTime?
  round      LetterDuelRound            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roundId, receivedAt])
}

model LetterDuelWordJudgment {
  word         String   @id
  accepted     Boolean
  reason       String?
  judgeVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum WordWeaverRoundStatus {
  WRITING
  JUDGING
  RESULTS
  CLOSED
}

enum WordWeaverEntryStatus {
  PENDING
  SCORED
  FAILED
}

model WordWeaverRoom {
  id               String    @id @default("public")
  currentRoundId   String?
  workerLeaseOwner String?
  workerLeaseUntil DateTime?
  updatedAt        DateTime  @updatedAt
}

model WordWeaverPresence {
  id         String   @id @default(cuid())
  userId     String
  clientId   String
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([lastSeenAt])
  @@index([userId, lastSeenAt])
}

model WordWeaverRound {
  id                   String                @id @default(cuid())
  number               Int                   @unique @default(autoincrement())
  status               WordWeaverRoundStatus @default(WRITING)
  word                 String
  missionId            String?
  missionType          String?
  nextMissionOptions   Json?
  nextMissionId        String?
  startedAt            DateTime              @default(now())
  writeDeadline        DateTime
  judgeStartedAt       DateTime?
  revealUntil          DateTime?
  resolvedAt           DateTime?
  isSolo               Boolean               @default(false)
  winnerUserId         String?
  nextWordPickerUserId String?
  winningEntryId       String?
  nextWord             String?
  judgeModel           String
  rubricVersion        String
  entries              WordWeaverEntry[]
  botTurns             WordWeaverBotTurn[]

  @@index([status, writeDeadline])
  @@index([status, revealUntil])
}

model WordWeaverEntry {
  id               String                @id @default(cuid())
  roundId          String
  userId           String?
  botPersonaId     String?
  text             String
  status           WordWeaverEntryStatus @default(PENDING)
  relevanceScore   Float?
  originalityScore Float?
  expressionScore  Float?
  feedback         String?
  finalScore       Int?
  failureMessage   String?
  judgeAttempts    Int                   @default(0)
  submittedAt      DateTime              @default(now())
  lockedAt         DateTime?
  judgedAt         DateTime?
  round            WordWeaverRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@unique([roundId, botPersonaId])
  @@index([roundId, status])
  @@index([roundId, finalScore(sort: Desc)])
}

enum WordWeaverBotTurnStatus {
  PENDING
  GENERATING
  SUBMITTED
  FAILED
}

model WordWeaverBotTurn {
  id            String                  @id @default(cuid())
  roundId       String
  personaId     String
  model         String
  promptVersion String                  @default("1")
  status        WordWeaverBotTurnStatus @default(PENDING)
  attempts      Int                     @default(0)
  leaseToken    String?
  leaseUntil    DateTime?
  round         WordWeaverRound         @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, personaId])
  @@index([roundId, status, leaseUntil])
}

model CountryRace {
  gameType GameType @default(COUNTRY)
  id String @id @default(cuid())
  status String @default("WAITING")
  playerOneId String
  playerTwoId String
  targetId String
  createdAt DateTime @default(now())
  startedAt DateTime?
  deadline DateTime?
  endedAt DateTime?
  winnerUserId String?
  endReason String?
  playerOneHeartbeat DateTime @default(now())
  playerTwoHeartbeat DateTime @default(now())
  playerOne User @relation("RaceOne", fields: [playerOneId], references: [id], onDelete: Cascade)
  playerTwo User @relation("RaceTwo", fields: [playerTwoId], references: [id], onDelete: Cascade)
  guesses CountryRaceGuess[]
  invite DuelInvite?
  matchOffer CountryMatchOffer?
  matchedSearch CountryMatchSearch?
  @@index([playerOneId, status])
  @@index([playerTwoId, status])
}

model CountryRaceGuess {
  id String @id @default(cuid())
  raceId String
  userId String
  itemId String
  rank Int
  createdAt DateTime @default(now())
  race CountryRace @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([raceId, userId, itemId])
  @@index([raceId, userId, rank])
}

model LetterDuelPracticeRound {
  id String @id @default(cuid())
  userId String @unique
  letters String[]
  acceptedWord String?
  surrenderedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DuelInvite {
  source String @default("DIRECT")
  id String @id @default(cuid())
  gameKind String @default("LETTER_DUEL")
  countryRaceId String? @unique
  countryRace CountryRace? @relation(fields: [countryRaceId], references: [id])
  senderId String
  recipientId String
  status String @default("PENDING")
  reason String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  respondedAt DateTime?
  startDeadline DateTime?
  senderReadyAt DateTime?
  recipientReadyAt DateTime?
  connectionId String? @unique
  sender User @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("InviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  connection LetterDuelConnection? @relation(fields: [connectionId], references: [id])

  @@index([senderId, status, createdAt])
  @@index([recipientId, status, createdAt])
  @@index([status, expiresAt])
}

model CompetitiveRating {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId String
  gameType String
  rating Int @default(1000)
  games Int @default(0)
  wins Int @default(0)
  losses Int @default(0)
  draws Int @default(0)
  updatedAt DateTime @updatedAt
  @@id([userId, gameType])
  @@index([gameType, rating])
}

model CompetitiveResult {
  matchKey String @id
  gameType String
  playerOneId String
  playerTwoId String
  winnerUserId String?
  oneBefore Int
  twoBefore Int
  oneAfter Int
  twoAfter Int
  createdAt DateTime @default(now())
}

model GeoChallengeNotificationConfig {
  gameType String @id
  enabledAt DateTime @default(now())
  lastQueuedStart DateTime?
}
