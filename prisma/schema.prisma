generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameType {
  IRAN_CITY
  COUNTRY
  ADJECTIVE
  ADJECTIVE_RAIN
  SEMANTRIS
  LETTER_DUEL
  PHRASE_HUNT
}

enum GameStatus {
  ACTIVE
  WON
  LOST
  DRAW
  SURRENDERED
}

enum LetterDuelMode {
  PRIVATE
  RANDOM
}

enum LetterDuelStatus {
  WAITING
  ACTIVE
  ENDED
}

enum LetterDuelRoundStatus {
  PICKING
  ANSWERING
  JUDGING
  RESOLVED
  CANCELLED
}

enum LetterDuelSubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  ERROR
}

model User {
  id                               String                 @id
  firstName                        String?
  lastName                         String?
  username                         String?
  photoUrl                         String?
  phraseHuntOnboardedAt            DateTime?
  wordWeaverOnboardedAt            DateTime?
  games                            GameSession[]
  presence                         OnlinePresence?
  letterDuelConnectionsAsPlayerOne LetterDuelConnection[] @relation("LetterDuelPlayerOne")
  letterDuelConnectionsAsPlayerTwo LetterDuelConnection[] @relation("LetterDuelPlayerTwo")
  letterDuelSubmissions            LetterDuelSubmission[]
  wordWeaverPresence               WordWeaverPresence[]
  wordWeaverEntries                WordWeaverEntry[]
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
}

model OnlinePresence {
  userId     String   @id
  isPlaying  Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPlaying, lastSeenAt])
}

model GameSession {
  id                String               @id @default(cuid())
  userId            String
  type              GameType
  targetId          String
  datasetVersion    String
  status            GameStatus           @default(ACTIVE)
  guessesCount      Int                  @default(0)
  startedAt         DateTime             @default(now())
  finishedAt        DateTime?
  semantrisState    Json?
  letterDuelRoundId String?
  duelOwnScore      Int?
  duelOpponentScore Int?
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesses           Guess[]
  phraseGuesses     PhraseHuntGuess[]
  phraseChallengeId String?
  phraseChallenge   PhraseHuntChallenge? @relation(fields: [phraseChallengeId], references: [id], onDelete: Restrict)
  letterDuelRound   LetterDuelRound?     @relation(fields: [letterDuelRoundId], references: [id], onDelete: Cascade)

  @@unique([userId, phraseChallengeId])
  @@index([userId, type, status])
  @@index([type, status, finishedAt])
  @@index([userId, targetId])
  @@index([phraseChallengeId])
}

model PhraseHuntChallenge {
  id           String                  @id
  startsAt     DateTime                @unique
  endsAt       DateTime
  targetId     String
  judgeVersion Int
  judgeModel   String                  @default("typesafe/jev-1.13")
  games        GameSession[]
  announcement PhraseHuntAnnouncement?
}

enum PhraseHuntAnnouncementStatus {
  PENDING
  COMPLETED
}

enum PhraseHuntAnnouncementDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model PhraseHuntNotificationConfig {
  id             String    @id @default("global")
  enabledAt      DateTime  @default(now())
  sendNotBefore  DateTime?
}

model PhraseHuntAnnouncement {
  id          String                           @id @default(cuid())
  challengeId String                           @unique
  messageText String
  status      PhraseHuntAnnouncementStatus     @default(PENDING)
  createdAt   DateTime                         @default(now())
  completedAt DateTime?
  challenge   PhraseHuntChallenge              @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  deliveries  PhraseHuntAnnouncementDelivery[]
}

model PhraseHuntAnnouncementDelivery {
  id             String                               @id @default(cuid())
  announcementId String
  chatId         String
  status         PhraseHuntAnnouncementDeliveryStatus @default(PENDING)
  attempts       Int                                  @default(0)
  nextAttemptAt  DateTime                             @default(now())
  leaseUntil     DateTime?
  sentAt         DateTime?
  lastError      String?
  announcement   PhraseHuntAnnouncement               @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, chatId])
  @@index([status, nextAttemptAt, leaseUntil])
}

model PhraseHuntGuess {
  id         String      @id @default(cuid())
  gameId     String
  phrase     String
  normalized String
  score      Float
  createdAt  DateTime    @default(now())
  game       GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, normalized])
  @@index([gameId, createdAt])
}

model PhraseHuntJudgment {
  id           String   @id @default(cuid())
  targetId     String
  phrase       String
  judgeVersion Int
  model        String   @default("typesafe/jev-1.13")
  score        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([targetId, phrase, judgeVersion, model])
}

model Guess {
  id        String      @id @default(cuid())
  gameId    String
  itemId    String
  rank      Int
  createdAt DateTime    @default(now())
  game      GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, itemId])
  @@index([gameId, createdAt])
}

model AdjectiveJudgment {
  id        String   @id @default(cuid())
  promptId  String
  word      String
  accepted  Boolean
  quality   Int
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promptId, word])
}

model LetterDuelConnection {
  id                 String            @id @default(cuid())
  mode               LetterDuelMode
  status             LetterDuelStatus  @default(WAITING)
  inviteToken        String?           @unique
  playerOneId        String
  playerTwoId        String?
  playerOneHeartbeat DateTime          @default(now())
  playerTwoHeartbeat DateTime?
  stateVersion       Int               @default(1)
  createdAt          DateTime          @default(now())
  startedAt          DateTime?
  endedAt            DateTime?
  playerOne          User              @relation("LetterDuelPlayerOne", fields: [playerOneId], references: [id], onDelete: Cascade)
  playerTwo          User?             @relation("LetterDuelPlayerTwo", fields: [playerTwoId], references: [id], onDelete: Cascade)
  rounds             LetterDuelRound[]

  @@index([status, mode, createdAt])
  @@index([playerOneId, status])
  @@index([playerTwoId, status])
}

model LetterDuelRound {
  id              String                 @id @default(cuid())
  connectionId    String
  number          Int
  status          LetterDuelRoundStatus  @default(PICKING)
  playerOneLetter String?
  playerTwoLetter String?
  pickDeadline    DateTime
  answerDeadline  DateTime?
  winnerUserId    String?
  winningWord     String?
  resultReason    String?
  createdAt       DateTime               @default(now())
  resolvedAt      DateTime?
  connection      LetterDuelConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sessions        GameSession[]
  submissions     LetterDuelSubmission[]

  @@unique([connectionId, number])
  @@index([connectionId, status])
}

model LetterDuelSubmission {
  id         String                     @id @default(cuid())
  roundId    String
  userId     String
  word       String
  status     LetterDuelSubmissionStatus @default(PENDING)
  reason     String?
  receivedAt DateTime                   @default(now())
  judgedAt   DateTime?
  round      LetterDuelRound            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roundId, receivedAt])
}

model LetterDuelWordJudgment {
  word         String   @id
  accepted     Boolean
  reason       String?
  judgeVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum WordWeaverRoundStatus {
  WRITING
  JUDGING
  RESULTS
  CLOSED
}

enum WordWeaverEntryStatus {
  PENDING
  SCORED
  FAILED
}

model WordWeaverRoom {
  id               String    @id @default("public")
  currentRoundId   String?
  workerLeaseOwner String?
  workerLeaseUntil DateTime?
  updatedAt        DateTime  @updatedAt
}

model WordWeaverPresence {
  id         String   @id @default(cuid())
  userId     String
  clientId   String
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([lastSeenAt])
  @@index([userId, lastSeenAt])
}

model WordWeaverRound {
  id                   String                @id @default(cuid())
  number               Int                   @unique @default(autoincrement())
  status               WordWeaverRoundStatus @default(WRITING)
  word                 String
  missionId            String?
  missionType          String?
  nextMissionOptions   Json?
  nextMissionId        String?
  startedAt            DateTime              @default(now())
  writeDeadline        DateTime
  judgeStartedAt       DateTime?
  revealUntil          DateTime?
  resolvedAt           DateTime?
  isSolo               Boolean               @default(false)
  winnerUserId         String?
  nextWordPickerUserId String?
  winningEntryId       String?
  nextWord             String?
  judgeModel           String
  rubricVersion        String
  entries              WordWeaverEntry[]
  botTurns             WordWeaverBotTurn[]

  @@index([status, writeDeadline])
  @@index([status, revealUntil])
}

model WordWeaverEntry {
  id               String                @id @default(cuid())
  roundId          String
  userId           String?
  botPersonaId     String?
  text             String
  status           WordWeaverEntryStatus @default(PENDING)
  relevanceScore   Float?
  originalityScore Float?
  expressionScore  Float?
  feedback         String?
  finalScore       Int?
  failureMessage   String?
  judgeAttempts    Int                   @default(0)
  submittedAt      DateTime              @default(now())
  lockedAt         DateTime?
  judgedAt         DateTime?
  round            WordWeaverRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@unique([roundId, botPersonaId])
  @@index([roundId, status])
  @@index([roundId, finalScore(sort: Desc)])
}

enum WordWeaverBotTurnStatus {
  PENDING
  GENERATING
  SUBMITTED
  FAILED
}

model WordWeaverBotTurn {
  id            String                  @id @default(cuid())
  roundId       String
  personaId     String
  model         String
  promptVersion String                  @default("1")
  status        WordWeaverBotTurnStatus @default(PENDING)
  attempts      Int                     @default(0)
  leaseToken    String?
  leaseUntil    DateTime?
  round         WordWeaverRound         @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, personaId])
  @@index([roundId, status, leaseUntil])
}
